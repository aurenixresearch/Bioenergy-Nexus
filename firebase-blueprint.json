{
  "entities": {
    "saved_paper": {
      "title": "Saved Paper",
      "description": "Represents a paper bookmarked by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique ID of the user saving the paper."
        },
        "paperId": {
          "type": "string",
          "description": "The unique ID of the research paper."
        },
        "savedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the paper was bookmarked."
        }
      },
      "required": ["userId", "paperId", "savedAt"]
    },
    "consultation_inquiry": {
      "title": "Consultation Inquiry",
      "description": "Represents a consulting or advisory inquiry submitted by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique ID of the user submitting the inquiry."
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "The email of the user submitting the inquiry."
        },
        "userName": {
          "type": "string",
          "description": "The name of the user."
        },
        "organization": {
          "type": "string",
          "description": "The company/organization of the user."
        },
        "serviceType": {
          "type": "string",
          "description": "The requested Bioenergy advisory service type."
        },
        "message": {
          "type": "string",
          "description": "Detailed description of the inquiry."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the inquiry was submitted."
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "In Review", "Resolved"],
          "description": "Status of the advisory request."
        }
      },
      "required": ["userId", "userEmail", "userName", "organization", "serviceType", "message", "createdAt", "status"]
    },
    "partnership_submission": {
      "title": "Partnership Submission",
      "description": "Represents an alliance or partnership submission.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique ID of the user submitting the partnership request."
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "The email of the user."
        },
        "partnerName": {
          "type": "string",
          "description": "Name of the organization or stakeholder seeking alliance."
        },
        "stakeholderType": {
          "type": "string",
          "description": "The type of the stakeholder."
        },
        "collaborationArea": {
          "type": "string",
          "description": "The primary area of collaboration."
        },
        "message": {
          "type": "string",
          "description": "Detailed description of the proposed alliance."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the alliance was registered."
        }
      },
      "required": ["userId", "userEmail", "partnerName", "stakeholderType", "collaborationArea", "message", "createdAt"]
    },
    "custom_paper": {
      "title": "Custom Research Paper",
      "description": "A research paper contributed to the repository by a registered member.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the research paper."
        },
        "author": {
          "type": "string",
          "description": "Author of the research paper."
        },
        "category": {
          "type": "string",
          "description": "Category of bioenergy/sustainability."
        },
        "abstract": {
          "type": "string",
          "description": "Abstract/summary of the study."
        },
        "downloadUrl": {
          "type": "string",
          "description": "Download or reference link."
        },
        "publishedYear": {
          "type": "number",
          "description": "The publication year."
        },
        "isCustom": {
          "type": "boolean",
          "description": "Always true."
        },
        "userId": {
          "type": "string",
          "description": "The unique ID of the submitting user."
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "Email of the submitting user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp."
        }
      },
      "required": ["title", "author", "category", "abstract", "downloadUrl", "publishedYear", "isCustom", "userId", "userEmail", "createdAt"]
    },
    "user_profile": {
      "title": "User Profile",
      "description": "Additional registration and onboarding details of a registered scholar.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The full name of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email of the user."
        },
        "role": {
          "type": "string",
          "description": "The selected user role (e.g., Student, Researcher, etc.)."
        },
        "country": {
          "type": "string",
          "description": "The country of origin or residence."
        },
        "institution": {
          "type": "string",
          "description": "Affiliated institution or organization."
        },
        "researchInterests": {
          "type": "array",
          "description": "The selected research interest tags."
        },
        "termsAccepted": {
          "type": "boolean",
          "description": "True indicating agreement to the Terms of Service and Privacy Policy."
        },
        "createdAt": {
          "type": "string",
          "description": "Onboarding creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "description": "Profile update timestamp."
        }
      },
      "required": ["fullName", "email", "role", "country", "termsAccepted"]
    },
    "conversation": {
      "title": "Conversation Thread",
      "description": "Represents a direct 1-on-1 private messaging conversation between connected users.",
      "type": "object",
      "properties": {
        "participants": {
          "type": "array",
          "description": "Array of participant user IDs (exactly 2 users)."
        },
        "lastMessage": {
          "type": "string",
          "description": "Text preview of the latest message."
        },
        "lastMessageTimestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the latest message."
        },
        "lastMessageSenderId": {
          "type": "string",
          "description": "User ID of the last sender."
        },
        "connectionType": {
          "type": "string",
          "description": "Type of connection permitting messaging ('mutual_follow' or 'collaboration')."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when conversation was started."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when conversation was last updated."
        }
      },
      "required": ["participants", "createdAt", "updatedAt"]
    },
    "message": {
      "title": "Chat Message",
      "description": "Individual message within a conversation thread.",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "description": "The unique ID of the parent conversation."
        },
        "senderId": {
          "type": "string",
          "description": "The unique ID of the sender user."
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender."
        },
        "text": {
          "type": "string",
          "description": "Body text of the message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the message was sent."
        },
        "readBy": {
          "type": "array",
          "description": "List of user IDs who have read this message."
        },
        "status": {
          "type": "string",
          "enum": ["sent", "delivered", "read"],
          "description": "Delivery and read status of the message."
        },
        "deliveredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when message was delivered to recipient."
        },
        "readAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when message was read by recipient."
        },
        "deletedFor": {
          "type": "array",
          "items": { "type": "string" },
          "description": "User IDs for whom this message is hidden."
        },
        "isDeletedForEveryone": {
          "type": "boolean",
          "description": "Whether the message has been deleted for all participants."
        },
        "replyTo": {
          "type": "object",
          "description": "Quoted parent message details when replying."
        }
      },
      "required": ["conversationId", "senderId", "text", "createdAt"]
    },
    "report": {
      "title": "User Report",
      "description": "Reports filed against users for moderation.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "reportedUserId": { "type": "string" },
        "conversationId": { "type": "string" },
        "reason": { "type": "string" },
        "comments": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["reporterId", "reportedUserId", "reason", "createdAt"]
    },
    "block": {
      "title": "Blocked User",
      "description": "User block relationships.",
      "type": "object",
      "properties": {
        "blockerId": { "type": "string" },
        "blockedUserId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["blockerId", "blockedUserId", "createdAt"]
    },
    "policy_acceptance": {
      "title": "Policy Acceptance Record",
      "description": "User consent and policy agreement audit trail record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User ID of accepting user." },
        "userEmail": { "type": "string", "format": "email", "description": "Email address of accepting user." },
        "userName": { "type": "string", "description": "Display name of accepting user." },
        "policyVersions": {
          "type": "object",
          "description": "Map of policy IDs to version strings accepted."
        },
        "acceptedAt": { "type": "string", "format": "date-time", "description": "Timestamp when policies were accepted." },
        "userAgent": { "type": "string", "description": "User agent string when accepted." }
      },
      "required": ["userId", "userEmail", "policyVersions", "acceptedAt"]
    },
    "policy_document": {
      "title": "Policy Document",
      "description": "Legal policy content document and version control.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "sections": {
          "type": "array",
          "description": "Array of policy sections with title and content."
        }
      },
      "required": ["title", "version", "lastUpdated"]
    },
    "community_post": {
      "title": "Community Post",
      "description": "A post published on the community feed by a scholar.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the author." },
        "authorName": { "type": "string", "description": "Full name of the author." },
        "authorInstitution": { "type": "string", "description": "Institution of the author." },
        "authorCountry": { "type": "string", "description": "Country of the author." },
        "authorAvatar": { "type": "string", "description": "Avatar image URL of the author." },
        "content": { "type": "string", "description": "Post body text content." },
        "imageUrl": { "type": "string", "description": "Optional image attachment URL." },
        "researchLink": { "type": "string", "description": "Optional link to related paper or research." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "likes": { "type": "array", "description": "Array of user IDs who liked the post." },
        "comments": { "type": "array", "description": "Array of comment objects." }
      },
      "required": ["userId", "authorName", "authorInstitution", "authorCountry", "content", "createdAt"]
    },
    "testimonial": {
      "title": "Member Testimonial",
      "description": "User feedback and testimonials for platform review and public display.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Optional user ID of the author." },
        "authorName": { "type": "string", "description": "Full name of the author." },
        "authorTitle": { "type": "string", "description": "Professional title or role." },
        "authorInstitution": { "type": "string", "description": "Affiliated organization or university." },
        "authorCountry": { "type": "string", "description": "Country of origin." },
        "content": { "type": "string", "description": "Testimonial review text." },
        "rating": { "type": "number", "description": "Rating score from 1 to 5." },
        "approved": { "type": "boolean", "description": "Whether approved by administrators for public display." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp." }
      },
      "required": ["authorName", "content", "createdAt"]
    }
  },
  "firestore": {
    "saved_papers": {
      "schema": "saved_paper",
      "description": "Bookmarked research papers for individual users."
    },
    "consultation_inquiries": {
      "schema": "consultation_inquiry",
      "description": "Inquiries submitted for advisory services."
    },
    "partnership_submissions": {
      "schema": "partnership_submission",
      "description": "Stakeholder partnership submissions."
    },
    "custom_papers": {
      "schema": "custom_paper",
      "description": "Member contributed research papers."
    },
    "reports": {
      "schema": "report",
      "description": "Moderation reports submitted by users."
    },
    "blocks": {
      "schema": "block",
      "description": "Blocked user entries."
    },
    "users": {
      "schema": "user_profile",
      "description": "Registered scholar profile details."
    },
    "conversations": {
      "schema": "conversation",
      "description": "Private messaging conversations."
    },
    "messages": {
      "schema": "message",
      "description": "Individual messages in private conversations."
    },
    "policy_acceptances": {
      "schema": "policy_acceptance",
      "description": "Audit trail of user legal policy agreements."
    },
    "policy_documents": {
      "schema": "policy_document",
      "description": "Dynamic legal policies and version records."
    },
    "community_posts": {
      "schema": "community_post",
      "description": "Shared community feeds and scholarly posts."
    },
    "testimonials": {
      "schema": "testimonial",
      "description": "Public member testimonials submitted for platform review and publication."
    }
  }
}
