rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isPlatformAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bola.adeyemi@aurenix-research.org' ||
        request.auth.token.email == 'adeyemibola2569@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        ))
      );
    }

    // Collection: saved_papers
    match /saved_papers/{savedPaperId} {
      allow read, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && isValidSavedPaper(incoming()) && incoming().userId == request.auth.uid;
    }

    function isValidSavedPaper(data) {
      return data.keys().hasAll(['userId', 'paperId', 'savedAt']) &&
             data.keys().size() == 3 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.paperId is string && data.paperId.size() <= 128 &&
             data.savedAt is string && data.savedAt.size() <= 50;
    }

    // Collection: consultation_inquiries
    match /consultation_inquiries/{inquiryId} {
      allow read, delete: if isSignedIn() && (isPlatformAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && (isPlatformAdmin() || (isValidConsultationInquiry(incoming()) && incoming().userId == request.auth.uid));
    }

    function isValidConsultationInquiry(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'userName', 'organization', 'serviceType', 'message', 'createdAt', 'status']) &&
             data.keys().size() == 8 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 128 &&
             data.userName is string && data.userName.size() <= 128 &&
             data.organization is string && data.organization.size() <= 128 &&
             data.serviceType is string && data.serviceType.size() <= 128 &&
             data.message is string && data.message.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.status is string && data.status.size() <= 50;
    }

    // Collection: partnership_submissions
    match /partnership_submissions/{submissionId} {
      allow read, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && isValidPartnershipSubmission(incoming()) && incoming().userId == request.auth.uid;
    }

    function isValidPartnershipSubmission(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'partnerName', 'stakeholderType', 'collaborationArea', 'message', 'createdAt']) &&
             data.keys().size() == 7 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 128 &&
             data.partnerName is string && data.partnerName.size() <= 128 &&
             data.stakeholderType is string && data.stakeholderType.size() <= 128 &&
             data.collaborationArea is string && data.collaborationArea.size() <= 128 &&
             data.message is string && data.message.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Collection: custom_papers
    match /custom_papers/{paperId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidCustomPaper(incoming()) && incoming().userId == request.auth.uid;
      allow update: if (
        // Action 1: Counter / Engagement metrics (Views, Downloads, Bookmarks) - Anyone can update
        (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'downloadsCount', 'bookmarksCount']) &&
         incoming().userId == existing().userId && incoming().createdAt == existing().createdAt &&
         (!('viewsCount' in incoming()) || (incoming().viewsCount is int || incoming().viewsCount is float)) &&
         (!('downloadsCount' in incoming()) || (incoming().downloadsCount is int || incoming().downloadsCount is float)) &&
         (!('bookmarksCount' in incoming()) || (incoming().bookmarksCount is int || incoming().bookmarksCount is float))) ||
        
        // Action 2: Comments and Contributions - Signed in users
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['comments', 'contributions']) &&
         incoming().userId == existing().userId && incoming().createdAt == existing().createdAt &&
         (!('comments' in incoming()) || (incoming().comments is list && incoming().comments.size() <= 500)) &&
         (!('contributions' in incoming()) || (incoming().contributions is list && incoming().contributions.size() <= 500))) ||
        
        // Action 3: Paper edits or new versions - Only the author (owner)
        (isSignedIn() && existing().userId == request.auth.uid && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt &&
         isValidCustomPaper(incoming()))
      );
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    function isValidCustomPaper(data) {
      return data.keys().hasAll(['title', 'author', 'category', 'abstract', 'downloadUrl', 'publishedYear', 'isCustom', 'userId', 'userEmail', 'createdAt']) &&
             data.title is string && data.title.size() <= 1000 &&
             data.author is string && data.author.size() <= 500 &&
             data.category is string && data.category.size() <= 200 &&
             data.abstract is string && data.abstract.size() <= 10000 &&
             data.downloadUrl is string && data.downloadUrl.size() <= 1000 &&
             (data.publishedYear is int || data.publishedYear is float) &&
             data.isCustom is bool &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             (!('viewsCount' in data) || (data.viewsCount is int || data.viewsCount is float)) &&
             (!('downloadsCount' in data) || (data.downloadsCount is int || data.downloadsCount is float)) &&
             (!('bookmarksCount' in data) || (data.bookmarksCount is int || data.bookmarksCount is float)) &&
             (!('comments' in data) || (data.comments is list && data.comments.size() <= 500)) &&
             (!('contributions' in data) || (data.contributions is list && data.contributions.size() <= 500)) &&
             (!('versions' in data) || (data.versions is list && data.versions.size() <= 50)) &&
             (!('researchMethodology' in data) || (data.researchMethodology is string && data.researchMethodology.size() <= 10000)) &&
             (!('keyFindings' in data) || (data.keyFindings is string && data.keyFindings.size() <= 10000)) &&
             (!('conclusion' in data) || (data.conclusion is string && data.conclusion.size() <= 10000));
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == request.auth.uid || isPlatformAdmin());
      allow create: if isSignedIn() && userId == request.auth.uid && (
        isPlatformAdmin() || 
        (isValidUserProfile(incoming()) && incoming().role != 'admin' && incoming().role != 'super_admin')
      );
      allow update: if isSignedIn() && (
        (userId == request.auth.uid && isValidUserProfile(incoming()) && incoming().role == existing().role && (!('adminRoleName' in incoming()) || incoming().adminRoleName == existing().adminRoleName)) ||
        isPlatformAdmin()
      );
      allow delete: if isSignedIn() && (userId == request.auth.uid || isPlatformAdmin());
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['fullName', 'email', 'role', 'country', 'termsAccepted', 'createdAt', 'updatedAt']) &&
             data.fullName is string && data.fullName.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role is string && data.role.size() <= 128 &&
             data.country is string && data.country.size() <= 128 &&
             data.termsAccepted is bool &&
             (!('institution' in data) || (data.institution is string && data.institution.size() <= 128)) &&
             (!('researchInterests' in data) || (data.researchInterests is list && data.researchInterests.size() <= 50)) &&
             (!('verificationStatus' in data) || (data.verificationStatus is string && data.verificationStatus.size() <= 50)) &&
             (!('verificationSubmittedAt' in data) || (data.verificationSubmittedAt is string && data.verificationSubmittedAt.size() <= 50)) &&
             (!('uploadedResearchCount' in data) || (data.uploadedResearchCount is int || data.uploadedResearchCount is float)) &&
             (!('verificationDetails' in data) || (data.verificationDetails is map)) &&
             (!('verified' in data) || (data.verified is bool)) &&
             (!('verificationApprovedAt' in data) || (data.verificationApprovedAt is string && data.verificationApprovedAt.size() <= 50)) &&
             (!('adminRoleName' in data) || (data.adminRoleName is string && data.adminRoleName.size() <= 128)) &&
             (!('projects' in data) || (data.projects is int || data.projects is float)) &&
             (!('followers' in data) || (data.followers is int || data.followers is float)) &&
             (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 100)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('researchCount' in data) || (data.researchCount is int || data.researchCount is float)) &&
             (!('needsOnboarding' in data) || (data.needsOnboarding is bool));
    }

    // Collection: researchers
    match /researchers/{researcherId} {
      allow read: if true;
      allow write: if true;
    }

    // Collection: publications
    match /publications/{publicationId} {
      allow read: if true;
      allow write: if true;
    }

    // Collection: projects (Collaboration)
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isPlatformAdmin() || incoming().createdBy == request.auth.uid);
      allow update, delete: if isSignedIn() && (isPlatformAdmin() || (resource != null && 'createdBy' in resource.data && resource.data.createdBy == request.auth.uid));
    }

    // Collection: alliance_opportunities (Collaboration)
    match /alliance_opportunities/{opportunityId} {
      allow read: if true;
      allow create: if isSignedIn() && (isPlatformAdmin() || incoming().createdBy == request.auth.uid);
      allow update, delete: if isSignedIn() && (isPlatformAdmin() || (resource != null && 'createdBy' in resource.data && resource.data.createdBy == request.auth.uid));
    }

    // Collection: applications (Collaboration)
    match /applications/{applicationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isPlatformAdmin() || incoming().applicantId == request.auth.uid);
      allow update, delete: if isSignedIn() && (isPlatformAdmin() || (resource != null && 'applicantId' in resource.data && resource.data.applicantId == request.auth.uid));
    }

    // Collection: workspaces (Collaboration)
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Collection: innovation_challenges (Collaboration)
    match /innovation_challenges/{challengeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Collection: notifications (Collaboration)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Collection: innovation_projects
    match /innovation_projects/{projectId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && isValidInnovationProject(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    function isValidInnovationProject(data) {
      return data.keys().hasAll(['userId', 'title', 'trl', 'status', 'fundingStatus', 'progress', 'industryPartner', 'laboratoryPartner', 'lastUpdated']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             (data.trl is int || data.trl is float) &&
             data.status is string && data.status.size() <= 50 &&
             data.fundingStatus is string && data.fundingStatus.size() <= 50 &&
             (data.progress is int || data.progress is float) &&
             data.industryPartner is string && data.industryPartner.size() <= 256 &&
             data.laboratoryPartner is string && data.laboratoryPartner.size() <= 256 &&
             data.lastUpdated is string && data.lastUpdated.size() <= 100 &&
             (!('id' in data) || data.id is string) &&
             (!('description' in data) || data.description is string && data.description.size() <= 2000);
    }

    // Collection: user_deadlines
    match /user_deadlines/{deadlineId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && isValidUserDeadline(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    function isValidUserDeadline(data) {
      return data.keys().hasAll(['userId', 'category', 'title', 'date', 'description', 'status']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.category is string && data.category.size() <= 50 &&
             data.title is string && data.title.size() <= 256 &&
             data.date is string && data.date.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.status is string && data.status.size() <= 50 &&
             (!('id' in data) || data.id is string);
    }

    // Collection: user_notifications
    match /user_notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && isValidUserNotification(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    function isValidUserNotification(data) {
      return data.keys().hasAll(['userId', 'type', 'title', 'message', 'isRead', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.type is string && data.type.size() <= 50 &&
             data.title is string && data.title.size() <= 256 &&
             data.message is string && data.message.size() <= 1000 &&
             data.isRead is bool &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             (!('id' in data) || data.id is string) &&
             (!('actionUrl' in data) || data.actionUrl is string && data.actionUrl.size() <= 512);
    }

    // Collection: organizations
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isSignedIn() && isPlatformAdmin();
    }

    // Collection: funding_opportunities
    match /funding_opportunities/{fundId} {
      allow read: if true;
      allow write: if isSignedIn() && isPlatformAdmin();
    }

    // Collection: reports
    match /reports/{reportId} {
      allow read, write: if isSignedIn() && isPlatformAdmin();
    }

    // Collection: audit_logs
    match /audit_logs/{logId} {
      allow read, write: if isSignedIn() && isPlatformAdmin();
    }

    // Collection: admin_roles
    match /admin_roles/{roleId} {
      allow read: if true;
      allow write: if isSignedIn() && isPlatformAdmin();
    }
  }
}
